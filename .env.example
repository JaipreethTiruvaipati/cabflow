# Settings for running a node outside docker compose (go run ./cmd/tripora).
DATABASE_URL=postgres://tripora:tripora@localhost:5432/tripora?sslmode=disable
JWT_SECRET=change-me-to-at-least-16-chars
NODE_NAME=local
HTTP_ADDR=:8080
# Leave empty to log notifications instead of sending them.
NOTIFY_URL=http://localhost:9000/notify
DB_MAX_CONNS=30
